#compdef repobundle

autoload -U is-at-least

_repobundle() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-o+[Write the bundle here. A path ending in \`.bundle\` is a file, anything else is a directory]:PATH:_files' \
'--output=[Write the bundle here. A path ending in \`.bundle\` is a file, anything else is a directory]:PATH:_files' \
'--name=[Filename template used when the output is a directory]:TEMPLATE:_default' \
'--refs=[Choose which refs to bundle]:REFS:(all branches head)' \
'(--prune-only)--prune=[After creating, keep only the newest N bundles of this repo]::N:_default' \
'--prune-only=[Keep only the newest N bundles of this repo without creating one]::N:_default' \
'(--prune --prune-only)--no-prune[Ignore the \`prune\` value from config files]' \
'(--prune --prune-only --dry-run --force -y --yes)--list[List this repo'\''s bundles, newest first, without creating one]' \
'--dry-run[Report what would be created and deleted without doing either]' \
'(--prune-only)--force[Create even if an identical bundle exists]' \
'(--prune-only --list)--include-wip[Bundle uncommitted changes to tracked files as refs/wip/repobundle]' \
'-y[Delete bundles over the prune limit without asking]' \
'--yes[Delete bundles over the prune limit without asking]' \
'--no-warnings[Suppress all warnings]' \
'--no-spinner[Don'\''t show a spinner while the bundle is written]' \
'--json[Print the result as one JSON object on stdout]' \
'--verbose[Log every git command and its exit status]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'::path -- Repository to bundle, or any directory inside it:_files' \
":: :_repobundle_commands" \
"*::: :->repobundle" \
&& ret=0
    case $state in
    (repobundle)
        words=($line[2] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:repobundle-command-$line[2]:"
        case $line[2] in
            (completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_repobundle__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:repobundle-help-command-$line[1]:"
        case $line[1] in
            (completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_repobundle_commands] )) ||
_repobundle_commands() {
    local commands; commands=(
'completion:Print a shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'repobundle commands' commands "$@"
}
(( $+functions[_repobundle__subcmd__completion_commands] )) ||
_repobundle__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'repobundle completion commands' commands "$@"
}
(( $+functions[_repobundle__subcmd__help_commands] )) ||
_repobundle__subcmd__help_commands() {
    local commands; commands=(
'completion:Print a shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'repobundle help commands' commands "$@"
}
(( $+functions[_repobundle__subcmd__help__subcmd__completion_commands] )) ||
_repobundle__subcmd__help__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'repobundle help completion commands' commands "$@"
}
(( $+functions[_repobundle__subcmd__help__subcmd__help_commands] )) ||
_repobundle__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'repobundle help help commands' commands "$@"
}

if [ "$funcstack[1]" = "_repobundle" ]; then
    _repobundle "$@"
else
    compdef _repobundle repobundle
fi
